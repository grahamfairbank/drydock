# Sign-in for the web console.
DRYDOCK_USER=admin
DRYDOCK_PASSWORD=change-me
# Port the console listens on.
DRYDOCK_PORT=9000
# Directory scanned for projects (folders with a compose file or Dockerfile).
DRYDOCK_PROJECTS_ROOT=/home/you
# Where Drydock keeps metrics history, exported bundles and imported projects.
# Must be an absolute host path.
DRYDOCK_DATA=/home/you/drydock/data
